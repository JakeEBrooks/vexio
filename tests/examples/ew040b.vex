$GLOBAL;
   ref $EXPER = EW1011X;
   ref $EOP = EOP011;

$EXPER;
def EW1011X;
   exper_name = EW1011X;
   exper_description = "VEXIO";
   exper_nominal_start = 2020y014d12h00m00s;
   exper_nominal_stop = 2020y015d12h00m00s;
   PI_name = "Bloggs, Joe";
   PI_email = some@totally_real_email.com;
   target_correlator = JIVE_E-VLBI;
enddef;

$MODE;
def sess324.C2048;
   ref $IF = LO@4088MHzDPolNoTone:O8;
   ref $IF = LO@4158MHzDPolNoTone:Ys;
   ref $IF = LO@4200MHzDPolNoTone:Tr;
   ref $IF = LO@4200MHzDPolNoTone#02:T6;
   ref $IF = LO@4587MHzDPolNoTone:Wb;
   ref $IF = LO@4600MHzDPolNoTone:Hh:Sr;
   ref $IF = LO@5664MHzDPolNoTone:Jb;
   ref $IF = LO@5664MHzDPolNoTone#02:Cm:Da:De:Kn:Pi;
   ref $BBC = 16BBCs:Jb;
   ref $BBC = 16BBCs#02:Hh:O8:Sr:Ys;
   ref $BBC = 16BBCs#03:Tr;
   ref $BBC = 16BBCs#04:T6;
   ref $BBC = 2BBCs:Cm:Da:De:Kn:Pi;
   ref $BBC = 8BBCs:Wb;
   ref $THREADS = CmThreads:Cm:Da:De:Kn:Pi;
   ref $THREADS = HhThreads:Hh:O8:Tr:Ys;
   ref $THREADS = JbThreads:Jb;
   ref $THREADS = SrThreads:Sr:T6;
   ref $THREADS = WbThreads:Wb;
   ref $FREQ = F4830.49MHz16x32MHz:Hh:Jb:O8:Sr:Tr:Ys;
   ref $FREQ = F4830.49MHz16x32MHz#02:T6;
   ref $FREQ = F4926.49MHz2x64MHz:Cm:Da:De:Kn:Pi;
   ref $FREQ = F4958.49MHz8x32MHz:Wb;
   ref $TRACKS = VDIF.16Ch2bit1to1:Hh:Jb:O8:Sr:T6:Tr:Ys;
   ref $TRACKS = VDIF.2Ch2bit1to1:Cm:Da:De:Kn:Pi;
   ref $TRACKS = VDIF.8Ch2bit1to1:Wb;
   ref $PHASE_CAL_DETECT = NoDetect:Hh:Jb:O8:Sr:T6:Tr:Ys;
   ref $PHASE_CAL_DETECT = NoDetect#02:Wb;
   ref $PHASE_CAL_DETECT = NoDetect#03:Cm:Da:De:Kn:Pi;
   ref $PROCEDURES = Mode_01;
enddef;

