"""vexio - A library for parsing, modifying, and creating VLBI Experiment (VEX) files."""

class Vex:
    """A Vex file.

    This is the top level type provided by this crate, and represents the full
    contents of a Vex file. A ``Vex`` can be constructed manually, or parsed
    from a string slice (see :meth:`parse`).
    """

    def __init__(self) -> None: ...
    @staticmethod
    def open(path: str) -> Vex: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> Vex: ...
    def save(self, path: str) -> None: ...
    def version(self) -> tuple[int, int]: ...
    def set_version(self, maj: int, min: int) -> None: ...
    def set_global(self, global_: Global) -> None: ...
    def set_station(self, station: HighLevelBlock) -> None: ...
    def set_mode(self, mode: HighLevelBlock) -> None: ...
    def set_primitive(self, primitive: Block) -> None: ...
    def set_schedule(self, sched: Schedule) -> None: ...

class Param:
    """A Vex parameter."""

    def __init__(self, name: str, values: list[str]) -> None: ...
    @staticmethod
    def new_empty(name: str) -> Param: ...
    def name(self) -> str: ...
    def add_value(self, value: str) -> None: ...
    def values(self) -> list[str]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> Param: ...

class ParamValue:
    """A single value of a defined Vex ``Param``.

    Parameter values are contained in a colon separated list in the Vex format.
    """

    def source(self) -> str: ...
    def kind(self) -> ParamValueKind: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> ParamValue: ...

class ParamValueKind:
    """The type of a particular ``ParamValue``."""

    Number: int
    NumberUnit: int
    Ident: int
    Literal: int
    Epoch: int
    Coord: int
    Link: int
    Empty: int

class VexRef:
    """A Vex `ref` declaration."""

    def __init__(self, blockname: str, keyword: str) -> None: ...
    @staticmethod
    def new_with_quals(
        blockname: str, keyword: str, qualifiers: list[str]
    ) -> VexRef: ...
    @property
    def blockname(self) -> str: ...
    @property
    def defname(self) -> str: ...
    @property
    def qualifiers(self) -> list[str]: ...
    def add_quals(self, qual: str) -> None: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> VexRef: ...

class Def:
    """A `def` block within a primitive Vex block."""

    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    def add_param(self, param: Param) -> None: ...
    def get_param(self, name: str) -> Param | None: ...
    def get_params(self, name: str) -> list[Param]: ...
    def param_names(self) -> list[str]: ...
    def params(self) -> list[Param]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> Def: ...

class Global:
    """Represents the unique ``GLOBAL`` block within a Vex file."""

    def __init__(self) -> None: ...
    def add_ref(self, refr: VexRef) -> None: ...
    def get(self, blk: str) -> list[VexRef]: ...
    def refs(self) -> list[VexRef]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> Global: ...

class HighLevelDef:
    """A `def` block within a high level Vex block."""

    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    def add_ref(self, refr: VexRef) -> None: ...
    def get(self, blk: str) -> list[VexRef]: ...
    def refs(self) -> list[VexRef]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> HighLevelDef: ...

class HighLevelBlock:
    """A high level Vex block. Currently this is either a `$MODE` or a `$STATION` block."""

    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    def get(self, name: str) -> HighLevelDef | None: ...
    @property
    def def_names(self) -> list[str]: ...
    @property
    def defs(self) -> list[HighLevelDef]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> HighLevelBlock: ...

class Block:
    """A primitive Vex block."""

    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    def get(self, name: str) -> Def | None: ...
    @property
    def def_names(self) -> list[str]: ...
    @property
    def defs(self) -> list[Def]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> Block: ...
    def add_def(self, defblk: Def): ...

class Scan:
    """A single scan within a ``Schedule``."""

    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    def add_param(self, param: Param) -> None: ...
    def get_param(self, name: str) -> Param | None: ...
    def get_params(self, name: str) -> list[Param]: ...
    def param_names(self) -> list[str]: ...
    def params(self) -> list[Param]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> Scan: ...

class Schedule:
    """Represents the unique ``SCHED`` block within a Vex file."""

    def __init__(self) -> None: ...
    def add_scan(self, scan: Scan) -> None: ...
    @property
    def scans(self) -> list[Scan]: ...
    def to_vex(self) -> str: ...
    def to_vex_minified(self) -> str: ...
    @staticmethod
    def parse(vex: str) -> Schedule: ...
