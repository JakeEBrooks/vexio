from enum import Enum

class BlockKind(Enum):
    HighLevel: BlockKind
    Primitive: BlockKind
    Schedule: BlockKind

class VexValueKind(Enum):
    Number: VexValueKind
    NumberUnit: VexValueKind
    Ident: VexValueKind
    Literal: VexValueKind
    Epoch: VexValueKind
    RightAscension: VexValueKind
    Declination: VexValueKind
    Link: VexValueKind
    Empty: VexValueKind

class VexValue:
    def __init__(
        self, source: str, kind: VexValueKind, unit: str | None = ...
    ) -> None: ...
    @staticmethod
    def number(value: float) -> VexValue: ...
    @staticmethod
    def integer(value: int) -> VexValue: ...
    @staticmethod
    def number_with_unit(value: float, unit: str) -> VexValue: ...
    @staticmethod
    def integer_with_unit(value: int, unit: str) -> VexValue: ...
    @staticmethod
    def ident(source: str) -> VexValue: ...
    @staticmethod
    def literal(source: str) -> VexValue: ...
    @staticmethod
    def epoch(source: str) -> VexValue: ...
    @staticmethod
    def right_ascension(source: str) -> VexValue: ...
    @staticmethod
    def declination(source: str) -> VexValue: ...
    @staticmethod
    def link(source: str) -> VexValue: ...
    @staticmethod
    def empty() -> VexValue: ...
    @staticmethod
    def parse(source: str) -> VexValue: ...
    @property
    def source(self) -> str: ...
    @source.setter
    def source(self, source: str) -> None: ...
    @property
    def kind(self) -> VexValueKind: ...
    @kind.setter
    def kind(self, kind: VexValueKind) -> None: ...
    @property
    def unit(self) -> str | None: ...
    @unit.setter
    def unit(self, unit: str | None) -> None: ...
    def clear_unit(self) -> None: ...
    def to_vex(self) -> str: ...

class VexVersion:
    def __init__(self, major: int, minor: int) -> None: ...
    @property
    def major(self) -> int: ...
    @property
    def minor(self) -> int: ...

class Global:
    def __init__(self) -> None: ...
    @staticmethod
    def parse(source: str) -> Global: ...
    def add(self, key: str, value: VexValue) -> VexValue | None: ...
    def get(self, key: str) -> VexValue | None: ...
    def remove(self, key: str) -> VexValue | None: ...
    def contains(self, key: str) -> bool: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[VexValue]: ...
    def to_vex(self) -> str: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: str) -> bool: ...
    def __getitem__(self, key: str) -> VexValue: ...
    def __setitem__(self, key: str, value: VexValue) -> None: ...

class BlockDef:
    def __init__(self, name: str, parent_kind: BlockKind) -> None: ...
    @staticmethod
    def highlevel(name: str) -> BlockDef: ...
    @staticmethod
    def primitive(name: str) -> BlockDef: ...
    @staticmethod
    def scan(name: str) -> BlockDef: ...
    @staticmethod
    def parse(source: str) -> BlockDef: ...
    @property
    def name(self) -> str: ...
    @property
    def parent_kind(self) -> BlockKind: ...
    @parent_kind.setter
    def parent_kind(self, kind: BlockKind) -> None: ...
    def add(self, name: str, values: list[VexValue]) -> None: ...
    def get(self, name: str) -> list[list[VexValue]] | None: ...
    def get_first(self, name: str) -> list[VexValue] | None: ...
    def remove(self, name: str) -> list[list[VexValue]] | None: ...
    def remove_single(self, name: str, index: int) -> list[VexValue] | None: ...
    def contains(self, name: str) -> bool: ...
    def keys(self) -> list[str]: ...
    def to_vex(self) -> str: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> bool: ...
    def __getitem__(self, name: str) -> list[list[VexValue]]: ...
    def __setitem__(self, name: str, occurrences: list[list[VexValue]]) -> None: ...

class Block:
    def __init__(self, name: str, kind: BlockKind) -> None: ...
    @staticmethod
    def highlevel(name: str) -> Block: ...
    @staticmethod
    def primitive(name: str) -> Block: ...
    @staticmethod
    def schedule() -> Block: ...
    @staticmethod
    def parse(source: str) -> Block: ...
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> BlockKind: ...
    def add(self, definition: BlockDef) -> BlockDef | None: ...
    def get(self, name: str) -> BlockDef | None: ...
    def remove(self, name: str) -> BlockDef | None: ...
    def contains(self, name: str) -> bool: ...
    def keys(self) -> list[str]: ...
    def definitions(self) -> list[BlockDef]: ...
    def to_vex(self) -> str: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> bool: ...
    def __getitem__(self, name: str) -> BlockDef: ...
    def __setitem__(self, name: str, definition: BlockDef) -> None: ...

class Vex:
    def __init__(self) -> None: ...
    @staticmethod
    def parse(source: str) -> Vex: ...
    @staticmethod
    def open(path: str) -> Vex: ...
    def save(self, path: str) -> None: ...
    def to_vex(self) -> str: ...
    @property
    def version(self) -> VexVersion: ...
    @version.setter
    def version(self, version: VexVersion) -> None: ...
    @property
    def global_block(self) -> Global: ...
    @global_block.setter
    def global_block(self, global_block: Global) -> None: ...
    def get_block(self, name: str) -> Block | None: ...
    def add_block(self, block: Block) -> Block | None: ...
    def remove_block(self, name: str) -> Block | None: ...
    def block_names(self) -> list[str]: ...
    def blocks(self) -> list[Block]: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str) -> bool: ...
    def __getitem__(self, name: str) -> Block: ...
    def __setitem__(self, name: str, block: Block) -> None: ...
